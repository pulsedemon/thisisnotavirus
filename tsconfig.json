{
  "compilerOptions": {
    "strict": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "downlevelIteration": true,
    "lib": ["ESNext", "dom", "dom.iterable", "ES2020"],
    "target": "es2020",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "exclude": ["node_modules", "build", "dist", "coverage"],
  "include": [
    "main.ts",
    "ascii.ts",
    "components/**/*.ts",
    "ui/**/*.ts",
    "utils/**/*.ts",
    "viruses/**/*.ts",
    "types/**/*.ts",
    "test-utils/**/*.ts",
    "vitest.setup.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
